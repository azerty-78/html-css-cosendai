    </div>
    <span class="output-label">// RÉSULTAT</span>
    <div class="output" id="if-out3">En attente…</div>

    <hr class="sd">
    <strong style="color:var(--accent)">🧪 Cas 4 — Validateur de formulaire (plusieurs if imbriqués)</strong>
    <div class="input-row">
      <input type="text" id="form-nom" placeholder="Votre nom" value="">
