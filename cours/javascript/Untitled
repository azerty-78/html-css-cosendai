</section>

<!-- ══ 3. TERNAIRE ══ -->
<section class="section" id="ternaire">
  <div class="section-header"><div class="section-number">03</div><h2>Opérateur ternaire — condition ? valeur1 : valeur2</h2></div>
  <div class="section-body">
    <div class="explainer">
      L'opérateur <strong>ternaire</strong> <code>?:</code> est un raccourci pour if/else sur une ligne.
      Syntaxe : <code>condition ? siVrai : siFaux</code>.
      Il retourne une valeur et peut être utilisé directement dans une expression. À utiliser pour les cas simples — pour la lisibilité, préférez if/else pour la logique complexe.
    </div>

    <div class="code-block"><span class="cm">// if/else classique :</span>
<span class="kw">let</span> <span class="var-c">frais</span>;
<span class="kw">if</span> (<span class="var-c">total</span> > <span class="num">200</span>) { <span class="var-c">frais</span> = <span class="str">"Gratuit"</span>; }
<span class="kw">else</span>               { <span class="var-c">frais</span> = <span class="str">"25 MAD"</span>; }

<span class="cm">// Équivalent avec l'opérateur ternaire :</span>
<span class="kw">let</span> <span class="var-c">frais</span> = (<span class="var-c">total</span> > <span class="num">200</span>) ? <span class="str">"Gratuit"</span> : <span class="str">"25 MAD"</span>;</div>

    <hr class="sd">
    <strong style="color:var(--accent)">🧪 Cas 1 — Frais de livraison</strong>
    <div class="slider-row">
      <label>Total commande (MAD) :</label>
      <input type="range" id="total-slider" min="0" max="500" value="150" oninput="cas_tern1()">
      <span id="total-val" style="font-family:'JetBrains Mono',monospace;color:var(--accent);font-weight:700;min-width:80px">150 MAD</span>
    </div>
    <span class="output-label">// RÉSULTAT</span>
    <div class="output" id="tern-out1">En attente…</div>

    <hr class="sd">
    <strong style="color:var(--accent)">🧪 Cas 2 — Parité en une ligne</strong>
    <div class="input-row">
      <input type="number" id="tern-n" value="7" style="width:100px">
      <button class="btn btn-blue" style="width:auto" onclick="cas_tern2()">▶ Pair ou Impair ?</button>
    </div>
    <span class="output-label">// RÉSULTAT</span>
    <div class="output" id="tern-out2">En attente…</div>

    <hr class="sd">
    <strong style="color:var(--accent)">🧪 Cas 3 — Ternaires imbriqués (à utiliser avec modération !)</strong>
    <div class="input-row">
      <input type="number" id="tern-score" value="65" min="0" max="100" style="width:100px">
      <button class="btn btn-green" style="width:auto" onclick="cas_tern3()">▶ Mention (ternaires imbriqués)</button>
    </div>
    <span class="output-label">// RÉSULTAT</span>
    <div class="output" id="tern-out3">En attente…</div>

    <hr class="sd">
    <strong style="color:var(--accent)">🧪 Cas 4 — Affichage conditionnel (usage réel en React/templates)</strong>
    <div class="input-row">
      <label>Connecté ?</label>
      <select id="tern-auth"><option value="oui">oui</option><option value="non">non</option></select>
      <label>Rôle :</label>
      <select id="tern-role"><option value="admin">admin</option><option value="user">user</option></select>
      <button class="btn btn-purple" style="width:auto" onclick="cas_tern4()">▶ Générer UI</button>
    </div>
    <span class="output-label">// MESSAGE D'INTERFACE</span>
    <div class="output" id="tern-out4">En attente…</div>
  </div>
