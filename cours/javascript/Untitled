  .btn{display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:8px;border:none;cursor:pointer;font-family:'Syne',sans-serif;font-size:.85rem;font-weight:700;transition:all .2s;text-align:center;justify-content:center;width:100%}
