}
function cas_forin(){
  const p={prenom:document.getElementById('fo-prenom').value,age:+document.getElementById('fo-age').value,filiere:document.getElementById('fo-filiere').value};
  let out=`<span style="color:var(--text-muted)">let etudiant = ${JSON.stringify(p,null,2)};\nfor (let cle in etudiant) { ... }\n\n</span>`;
  for(let k in p){out+=`<span style="color:var(--accent3)">clé: "${k}" → valeur: "${p[k]}"</span>\n`;}
  setOut('for-out2',out);
}
function cas_forof(){
  const raw=document.getElementById('fo-arr').value;
  const seuil=+document.getElementById('fo-seuil').value;
  const arr=raw.split(',').map(Number).filter(n=>!isNaN(n));
  const filtres=arr.filter(n=>n>seuil);
  let out=`<span style="color:var(--text-muted)">for (let n of [${arr.join(',')}]) {\n  if (n > ${seuil}) filtres.push(n);\n}\n\n</span>`;
  arr.forEach(n=>{out+=`<span style="color:${n>seuil?'var(--accent3)':'var(--text-muted)'}">${n>seuil?'✓':'✗'} ${n} ${n>seuil?'> '+'ajouté':'<= ignoré'}</span>\n`;});
  out+=`\n<span style="color:var(--accent2)">→ Résultat : [${filtres.join(', ')}]</span>`;
  setOut('for-out3',out);
}
function cas_stats(){
  const raw=document.getElementById('fo-notes').value;
  const notes=raw.split(',').map(Number).filter(n=>!isNaN(n));
  if(!notes.length){setOut('for-out4','<span style="color:var(--danger)">Aucune note valide.</span>');return;}
  let sum=0,min=notes[0],max=notes[0];
  for(let note of notes){sum+=note;if(note<min)min=note;if(note>max)max=note;}
  const moy=(sum/notes.length).toFixed(2);
  setOut('for-out4',`<span style="color:var(--text-muted)">Notes : [${notes.join(', ')}]\n\n</span>`+`<span style="color:var(--accent3)">Somme  : ${sum}</span>\n<span style="color:var(--accent2)">Moyenne : ${moy}</span>\n<span style="color:var(--accent)">Min : ${min}</span>\n<span style="color:var(--accent4)">Max : ${max}</span>\n<span style="color:${moy>=10?'var(--accent3)':'var(--danger)'}">→ ${moy>=10?'Moyenne satisfaisante ✓':'Moyenne insuffisante ✗'}</span>`);
}

// ══ TRY/CATCH ══
function cas_tc1(){
  const v=document.getElementById('tc-val').value;
  let out=`<span style="color:var(--text-muted)">try {\n</span>`;
  try{
    if(v===''){throw new Error('Champ vide !');}
    if(isNaN(v)){throw new Error(`"${v}" n'est pas un nombre !`);}
    const n=+v;
    if(n<5){throw new RangeError(`${n} est trop petit (min: 5)`);}
    if(n>100){throw new RangeError(`${n} est trop grand (max: 100)`);}
    out+=`<span style="color:var(--accent3)">  ✓ Valeur valide : ${n}\n  → Pas d'erreur !\n</span>`;
  }catch(e){
    out+=`<span style="color:var(--danger)">} catch(err) {\n  console.error(err.message);\n  → "${e.message}"\n  Type: ${e.constructor.name}\n</span>`;
  }finally{
    out+=`<span style="color:var(--accent)">} finally {\n  → Ce bloc s'exécute TOUJOURS (nettoyage, fermeture connexion...)\n}</span>`;
  }
  setOut('tc-out1',out);
}
function cas_tc2(){
  const t=document.getElementById('tc-type').value;
  try{
    if(t==='RangeError') throw new RangeError('Valeur hors des limites autorisées !');
    if(t==='TypeError') throw new TypeError('Type de donnée incorrect !');
    throw new Error('Erreur personnalisée de l\'application !');
  }catch(e){
    setOut('tc-out2',`<span style="color:var(--text-muted)">try { throw new ${t}("..."); }\n</span><span style="color:var(--danger)">catch(err) {\n  err.name    : "${e.name}"\n  err.message : "${e.message}"\n}</span>`);
  }
}
function cas_tc3(){
  const n=+document.getElementById('tc-num').value;
  const d=+document.getElementById('tc-den').value;
  try{
    if(d===0)throw new Error('Division par zéro interdite !');
    const r=n/d;
    setOut('tc-out3',`<span style="color:var(--accent3)">✓ ${n} ÷ ${d} = ${r}</span>`);
  }catch(e){
    setOut('tc-out3',`<span style="color:var(--danger)">✕ catch(err): "${e.message}"\n→ Résultat sécurisé : Infinity (en JS pur) mais notre validation bloque cela.</span>`);
  }
}
function cas_tc4(){
  const j=document.getElementById('tc-json').value;
  try{
    const obj=JSON.parse(j);
    let out=`<span style="color:var(--accent3)">✓ JSON valide ! Objet parsé :\n</span>`;
    for(let k in obj){out+=`<span style="color:var(--accent2)">  ${k}: ${JSON.stringify(obj[k])}\n</span>`;}
    setOut('tc-out4',out);
  }catch(e){
    setOut('tc-out4',`<span style="color:var(--danger)">✕ JSON invalide !\ncatch(err): ${e.message}\n→ JSON doit utiliser des guillemets doubles et une syntaxe stricte.</span>`);
  }
}
