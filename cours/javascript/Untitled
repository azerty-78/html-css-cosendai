      <span id="note-val" style="font-family:'JetBrains Mono',monospace;font-size:1.3rem;font-weight:700;color:var(--accent);min-width:50px">75</span>
    </div>
    <div class="result-big" id="note-result">—</div>
    <span class="output-label">// CODE EXÉCUTÉ</span>
    <div class="output" id="if-out1">En attente…</div>

